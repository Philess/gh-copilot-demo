@{
    ViewData["Title"] = "Products";
}

<div class="container">
    <h1>Products</h1>
    <p>This is the Products page where you can browse our product catalog.</p>
    
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Product 1</h5>
                    <p class="card-text">High-quality product with excellent features.</p>
                    <p class="text-primary fw-bold">$99.99</p>
                    <button class="btn btn-primary">Add to Cart</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Product 2</h5>
                    <p class="card-text">Premium quality with advanced functionality.</p>
                    <p class="text-primary fw-bold">$149.99</p>
                    <button class="btn btn-primary">Add to Cart</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Product 3</h5>
                    <p class="card-text">Best value for money in its category.</p>
                    <p class="text-primary fw-bold">$79.99</p>
                    <button class="btn btn-primary">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</div>
